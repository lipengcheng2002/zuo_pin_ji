# ── Site ─────────────────────────────────────────────────────────────
# Public URL, used by metadata, sitemap, robots and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_VERSION=1.1.0
# Agent service release label surfaced by /api/agent/capabilities.
# AGENT_SERVICE_VERSION=1.1.0
# Demo-only staged animation; keep false/absent for production latency.
AGENT_SIMULATE_LATENCY=false
# Platform kill switch for the agent (true/false).
AGENT_ENABLED=true
# Bearer token for /api/ops/orders (fulfilment/refund); empty disables it.
# OPS_TOKEN=replace-with-a-long-random-token
# Bearer token for /api/agents/* (agent lifecycle administration).
# AGENT_ADMIN_TOKEN=replace-with-a-long-random-token

# ── Storage ───────────────────────────────────────────────────────────
# File driver (default): atomically written JSON in this directory.
# Mount this path as a persistent volume in production.
DATA_DIR=./.data

# PostgreSQL driver (optional). When set, the file driver is bypassed and a
# single JSONB document is stored in table `zhiyan_app_state`.
# DATABASE_URL=postgresql://zhiyan:zhiyan@localhost:5432/zhiyan
# PGSSL=false
# PG_POOL_MAX=5


# ── Customer login ────────────────────────────────────────────────────
# Demo mode simulates WeChat OAuth and returns the phone OTP in the response.
# Set to false after wiring WeChat Open Platform + an SMS provider.
DEMO_AUTH=true
DEMO_OTP_CODE=246810

# Real WeChat OAuth (H5 website app). Callback must be public HTTPS and
# registered as https://<your-domain>/api/auth/wechat/callback.
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_OAUTH_SCOPE=snsapi_userinfo

# ── LLM (optional, OpenAI-compatible) ────────────────────────────────
# Preferred for production: set the key here or via a secret manager.
# Leave empty to use the local deterministic planner.
# DeepSeek example: https://api.deepseek.com/v1 + deepseek-chat
# OpenAI example:  https://api.openai.com/v1 + gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Enable only after validating the planner prompt against your provider.
LLM_PLANNER=false
LLM_TIMEOUT_MS=9000
# Reserved for legacy encrypted config migrations; API keys should come from
# environment/secret manager in production.
# LLM_CONFIG_SECRET=replace-with-a-long-random-secret
